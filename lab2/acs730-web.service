[Unit]
Description=ACS730 Lab 2 web application
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=acs730-lab2-svc
Group=acs730-lab2-svc
WorkingDirectory=/opt/acs730-lab2-web
ExecStart=/usr/bin/python3 -m http.server 80 --directory /opt/acs730-lab2-web
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
